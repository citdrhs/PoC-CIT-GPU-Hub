[Unit]
Description=CIT GPU Hub scheduler
After=gpuhub-api.service

[Service]
Type=simple
User=gpuhub
Group=gpuhub
WorkingDirectory=/opt/cit-gpu-hub
EnvironmentFile=/etc/cit-gpu-hub/runtime.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/cit-gpu-hub/.venv/bin/python -m services.scheduler
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/srv/cit-gpu-hub
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
