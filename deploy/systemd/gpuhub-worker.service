[Unit]
Description=CIT GPU Hub native CPU worker
After=docker.service gpuhub-api.service
Requires=docker.service

[Service]
Type=simple
User=gpuhub
Group=gpuhub
SupplementaryGroups=docker
WorkingDirectory=/opt/cit-gpu-hub
EnvironmentFile=/etc/cit-gpu-hub/runtime.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/cit-gpu-hub/.venv/bin/python -m services.worker run --backend docker --node cit-cpu --name "CIT CPU"
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/srv/cit-gpu-hub
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
